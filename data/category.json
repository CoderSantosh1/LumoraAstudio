        "Faq": {
          "variants": {
            "PhotographyFaq1": {
              "subtitle": "FAQ",
              "title1": "Frequently Asked",
              "titleScript": "Questions",
              "description": "Find answers to the most common questions about our photography services, booking process, pricing and more. If you still need help, feel free to contact our team anytime.",
              "groupTitle": "General Questions",
              "faqGroups": [
                [
                  {
                    "id": "q1-1",
                    "question": "How long have you been a photographer?",
                    "answer": "We have been working in the photography industry for over 10 years, capturing weddings, newborn, fashion and portfolio photography. Our experience allows us to create beautiful, high-quality images that tell your unique story."
                  },
                  {
                    "id": "q1-2",
                    "question": "Do you edit all of your photographs?",
                    "answer": "Yes. Every image we deliver is carefully selected and professionally edited for colour, light and tone so your gallery feels consistent and timeless."
                  },
                  {
                    "id": "q1-3",
                    "question": "Do you work with a second photographer?",
                    "answer": "For weddings and large events we usually work with a second photographer, so no important moment or angle is missed."
                  },
                  {
                    "id": "q1-4",
                    "question": "Do you have an assistant?",
                    "answer": "Yes, an assistant joins us on most shoots to help with lighting, equipment and keeping everything running smoothly."
                  },
                  {
                    "id": "q1-5",
                    "question": "Do you also provide video services?",
                    "answer": "We do. Our team offers wedding cinematography, event films and drone coverage alongside photography."
                  },
                  {
                    "id": "q1-6",
                    "question": "Do you have past clients we can speak to as references?",
                    "answer": "Of course. We are happy to connect you with past clients who can share their experience of working with us."
                  }
                ],
                [
                  {
                    "id": "q2-1",
                    "question": "Are our digital files watermarked?",
                    "answer": "No. The final digital files you receive are high resolution and free from any watermark."
                  },
                  {
                    "id": "q2-2",
                    "question": "How many pictures will we receive?",
                    "answer": "It depends on the package and length of the shoot. A full-day wedding typically includes several hundred edited images."
                  },
                  {
                    "id": "q2-3",
                    "question": "How long does it take before we receive our products and photographs?",
                    "answer": "Sneak peeks are shared within a week. The complete edited gallery is usually delivered within 3 to 4 weeks."
                  }
                ]
              ],
              "image": "/Faq/FaqPhotographer.png",
